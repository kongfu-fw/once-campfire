<% content_for :footer do %>
  <div class="composer flex align-end gap position-relative"
      data-controller="typing-notifications voice-recorder"
      data-typing-notifications-active-class="typing-indicator--active"
      data-voice-recorder-form-url-value="<%= room_messages_path(room) %>"
      data-voice-recorder-messages-outlet="#message-area">
    <%= link_to searches_path, class: "btn flex-item-no-shrink margin-block-end composer__context-btn", style: "view-transition-name: input-switcher" do %>
      <%= image_tag "search.svg", size: 20, aria: { hidden: "true" } %>
      <span class="for-screen-reader">Search</span>
    <% end %>

    <turbo-frame id="composer-frame">
      <%= composer_form_tag(room) do |form| %>
        <fieldset data-composer-target="fields" contents>
          <div class="flex flex-column">
            <div class="composer__filelist flex flex--align-center gap flex-wrap" data-composer-target="fileList"></div>

            <div class="flex composer__input input input--actor fill-white min-width" style="--input-border-radius: 1.3rem">
              <div class="flex align-end gap full-width">
                <%= image_tag "messages-outlined.svg", size: 22, aria: { hidden: "true" }, class: "composer__input-hint colorize--black", style: "view-transition-name: input-btn;" %>

                <div class="flex flex-column flex-item-grow min-width gap">
                  <%= form.rich_text_area :body,
                        rows: 1,
                        class: "input",
                        style: "order: -1",
                        aria: { multiline: "true", label: "Write a message" },
                        data: {
                          controller: "rich-autocomplete",
                          action: rich_text_data_actions,
                          rich_autocomplete_url_value: autocompletable_users_path(room_id: room.id),
                          permitted_attachment_types: "application/vnd.actiontext.opengraph-embed",
                          composer_target: "text" } %>
                </div>

                <button class="btn btn--borderless txt-small flex-item-no-shrink composer__mic-btn" type="button" data-action="voice-recorder#toggle">
                  <%= image_tag "microphone.svg", size: 22, class: "colorize--black", aria: { hidden: "true" } %>
                  <span class="for-screen-reader">Record voice message</span>
                </button>

                <label class="btn btn--borderless txt-small flex-item-no-shrink composer__attachment-btn input--file">
                  <%= image_tag "attachment.svg", size: 22, class: "colorize--black", aria: { hidden: "true" } %>
                  <input type="file" data-action="composer#filePicked" multiple />
                  <span class="for-screen-reader">Attach a file</span>
                </label>

                <button class="btn btn--borderless txt-small flex-item-no-shrink composer__rich-text-btn" type="button" data-action="composer#toggleToolbar">
                  <%= image_tag "text-options.svg", size: 20, class: "colorize--black", aria: { hidden: "true" } %>
                  <span class="for-screen-reader">Rich text</span>
                </button>

                <%= form.button name: "send", type: "submit", data: { action: "composer#submit" },
                      class: "btn btn--reversed flex-item-no-shrink txt-small" do %>
                  <%= image_tag "arrow-up.svg", size: 20, aria: { hidden: "true" } %>
                  <span class="for-screen-reader">Send Message</span>
                <% end %>
              </div>
            </div>
          </div>
        </fieldset>

        <div class="typing-indicator gap txt-small align-center flex-inline" data-typing-notifications-target="indicator">
          <div class="typing-indicator__author spinner" data-typing-notifications-target="author"></div>
        </div>

        <%= form.hidden_field :client_message_id, data: { composer_target: "clientid" } %>
      <% end %>
    </turbo-frame>

    <div class="voice-recorder" data-voice-recorder-target="panel" hidden>
      <div class="voice-recorder__content border shadow">
        <button class="btn btn--plain voice-recorder__close-btn" type="button" data-action="voice-recorder#discard">
          <%= image_tag "remove.svg", size: 20, class: "colorize--black", aria: { hidden: "true" } %>
          <span class="for-screen-reader">Close</span>
        </button>

        <div class="voice-recorder__recording flex flex-column align-center gap" data-voice-recorder-target="recording">
          <div class="flex align-center full-width">
            <div class="flex-item-grow flex justify-end" style="padding-inline-end: 1em;">
              <span class="voice-recorder__timer" data-voice-recorder-target="timer">0:00</span>
            </div>
            <button class="voice-recorder__record-btn btn flex-shrink-0"
                    type="button"
                    data-voice-recorder-target="recordBtn"
                    data-action="voice-recorder#toggleRecording">
              <span data-voice-recorder-target="startIcon">
                <%= image_tag "microphone.svg", size: 32, class: "colorize--black", aria: { hidden: "true" } %>
              </span>
              <span data-voice-recorder-target="stopIcon" hidden>
                <div class="voice-recorder__stop-square"></div>
              </span>
              <span class="for-screen-reader">Toggle recording</span>
            </button>
            <div class="flex-item-grow"></div>
          </div>
          <span class="voice-recorder__hint txt-small txt-subtle">Max length: 59s</span>
        </div>

        <div class="voice-recorder__preview flex flex-column gap" data-voice-recorder-target="preview" hidden>
          <audio data-voice-recorder-target="audio"
                 data-action="play->voice-recorder#onPlay pause->voice-recorder#onPause timeupdate->voice-recorder#onTimeUpdate ended->voice-recorder#onEnded"></audio>

          <div class="flex align-center justify-center full-width" style="gap: 2rem;">
            <button class="btn btn--plain" type="button" data-action="voice-recorder#playPreview" style="width: 4em; height: 4em; border-radius: 50%; background: var(--color-bg); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center;">
              <span data-voice-recorder-target="playIcon" style="padding-inline-start: 4px; line-height: 0;">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <polygon points="6,3 17,10 6,17"></polygon>
                </svg>
              </span>
              <span data-voice-recorder-target="pauseIcon" style="line-height: 0;" hidden>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <rect x="5" y="3" width="3" height="14"></rect>
                  <rect x="12" y="3" width="3" height="14"></rect>
                </svg>
              </span>
            </button>

            <span class="voice-recorder__timer" data-voice-recorder-target="previewTimer">0:00</span>

            <button class="btn btn--reversed" type="button" data-action="voice-recorder#send" style="width: 4em; height: 4em; border-radius: 50%; padding: 0; display: flex; align-items: center; justify-content: center;">
              <%= image_tag "arrow-up.svg", size: 24, aria: { hidden: "true" } %>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
